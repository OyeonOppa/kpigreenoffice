{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kpigreenoffice-live",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",

  "observability": {
    "enabled": true
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },

  // ต้องเป็น SQLite backend — แผนฟรีของ Cloudflare รองรับเฉพาะแบบนี้
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],

  // ฐานข้อมูลแคมเปญป่า 3R (#/forest) — เก็บผู้ใช้ + แต้ม
  //
  // ยังปิดอยู่: /api/forest/* จะตอบ 503 จนกว่าจะเปิดบล็อกนี้ (เกมแยกขยะแข่งสด deploy ได้ตามปกติ)
  //
  // เปิดใช้:
  //   1. npx --prefix worker wrangler d1 create kpi-forest
  //   2. ลบเครื่องหมาย // หน้า "d1_databases" ข้างล่าง แล้วใส่ database_id ที่ได้
  //   3. npx --prefix worker wrangler d1 migrations apply kpi-forest --remote
  //   4. npx --prefix worker wrangler secret put SESSION_SECRET   (พิมพ์สตริงสุ่มยาวๆ)
  //   5. node scripts/gen-users.mjs <ไฟล์รายชื่อ.csv>
  //      npx --prefix worker wrangler d1 execute kpi-forest --remote --file=seed/users.sql
  //
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "kpi-forest", "database_id": "PUT-D1-DATABASE-ID-HERE" }
  // ],

  "vars": {
    // เว็บที่เปิด WebSocket มาที่ห้องนี้ได้ (คั่นด้วย , — เทียบแบบตรงตัว ไม่มี wildcard)
    // ตัวแรกคือโดเมนจริงที่ใช้ในงาน · kpi-lowcarbon.pages.dev เก็บไว้เป็นสำรอง/ตอนทดสอบ
    // ที่เหลือคือ localhost ตอนพัฒนา
    // เกมนี้ไม่มีล็อกอิน ด่านนี้จึงเป็นด่านเดียวที่กันคนนอก — อย่าใส่ * หรือปล่อยว่าง
    // แก้ไฟล์นี้แล้วต้อง `npm --prefix worker run deploy` ใหม่ ค่าถึงจะมีผล
    "ALLOWED_ORIGINS": "https://lowcarbon.kpi.ac.th,https://kpi-lowcarbon.pages.dev,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"
  }
}
