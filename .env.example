# ---------- เกมแยกขยะแข่งสด ----------

# ที่อยู่ของ Worker — ตั้งค่านี้แล้วเว็บจะใช้หลังบ้านจริง (Cloudflare Durable Object)
# ไม่ตั้ง = ใช้โหมดจำลองในเครื่อง (ซ้อมข้ามแท็บได้ ไม่ต้องมีเซิร์ฟเวอร์)
#
# ตอนพัฒนาในเครื่อง (รัน `npm run dev` ที่โฟลเดอร์ worker คู่กันไป):
#   VITE_LIVE_API=http://127.0.0.1:8787
# ตอนขึ้นจริง:
#   VITE_LIVE_API=https://kpigreenoffice-live.<subdomain>.workers.dev
VITE_LIVE_API=

# OAuth Client ID จาก Google Cloud Console (ชนิด Web application)
# ค่านี้เปิดเผยได้ ไม่ใช่ความลับ — ตัวที่ห้ามเปิดเผยคือ client secret ซึ่งเราไม่ใช้
# ว่างไว้ = ใช้ล็อกอินแบบพัฒนา (กรอกชื่ออย่างเดียว) ซึ่ง Worker ต้องเปิด DEV_ALLOW_FAKE_AUTH ด้วย
VITE_GOOGLE_CLIENT_ID=
